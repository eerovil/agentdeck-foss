[Unit]
Description=agentdeck voice mode wake word detector (#3476)
# Starts at login (or on demand by agentdeck-wake.socket) and stays up: by the
# owner's decision on #3793, "Hey Jarvis" works at once even after a long break,
# rather than waiting for a cold start. CPU only, about 0.5 GB of memory.
Requires=agentdeck-wake.socket

[Service]
# Never a desktop password box (#4340): the KDE session hands the user manager
# SSH_ASKPASS, and git runs it before it reads GIT_TERMINAL_PROMPT, so a git or
# ssh call from here would open a box nobody sees and hang until its timeout.
# With DISPLAY set, ssh runs its built-in askpass even then, unless told never to.
UnsetEnvironment=SSH_ASKPASS SUDO_ASKPASS GIT_ASKPASS
Environment=GIT_TERMINAL_PROMPT=0 SSH_ASKPASS_REQUIRE=never
ExecStart=%h/.local/share/agentdeck/speech-venv/bin/python %h/agentdeck/scripts/wake_server.py --idle-exit 0
# Heard live, like the speech service: keep it ahead of test suites for the CPU.
CPUWeight=500
# Never swapped out (#4669): loaded is not enough. On a full host a break left
# 0.6 GB of it in swap.
MemorySwapMax=0
# A crash restarts it, so the next wake does not wait for a cold start.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
